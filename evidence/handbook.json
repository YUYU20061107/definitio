  "format": "definitio-handbook-v1",
  "handle_resolution": {
    "codes": [
      "STALE",
      "AMBIGUOUS"
    ],
    "counting_rule": "捕获证明按「角色 + 稳定字段」去重计数；值(value/values)、范围(range/ranges/bounds/extent)、计数(count/feature_count)等易变量不作身份。同一身份的多次观测计 1；0 个身份判 STALE，>=2 个身份判 AMBIGUOUS，恰好 1 个身份才解析为句柄。"
  },
  "instructions": "Definitio: the calling Agent owns planning.\n1. workflow_route(intent) selects a verb family. workspace_list filters by name,\nfields and CRS. dataset_describe gives the selected inputs' exact schema.\n2. Compact MCP: gis_describe_algorithm gives the exact schema, gis_call executes it.\nThe full profile exposes direct gis_* tools. Use raster_import for bounded single-band\ngrids; explicit NoData/units/light/convention are required, with no implicit resampling.\n3. Use known CRS and x,y coordinates. reproject moves coordinates; assign_projection\nchanges metadata. Planar analysis uses projected CRS, metres and m². Binary polygon\noperations use identical CRS. gis_validate_geometry reports the valid flag.\n4. task_dry_run computes each step in memory and shows actual fields, CRS, counts\nand effects. task_plan stores the reviewed chain; task_execute uses its exact digest.\n$previous is the immediately preceding dataset output; never reference its new\ntarget name before execution. Step parameters contain operation arguments only:\nput request_id on task_plan and authorization_id on task_execute, never in steps.\nDissolve keeps only its\nexplicit fields ([] means all); clip keeps input fields; spatial_filter selects\nwhole records; merge concatenates matching schemas into a new dataset.\n5. Use existing authorization: confirm=true + stable request_id for one write,\nor authorization_grant once for a session prefix/verbs/count/TTL, then pass\n authorization_id. Scoped writes derive stable request IDs automatically.\nauthorization_get reports use; authorization_revoke ends new writes.\n6. Read summaries first; artifact_view provides JSON-pointer drill-down and cursors.\nartifact_read provides exact JSON chunks. On a lost response reuse identical arguments\nand request_id, or task_get. Check ok, valid and task state; partial chains retain\ncommitted outputs. FAILED/ISOLATED receipts are inspected before creating a new task.",
  "read_states": [
    "Known",
    "Absent",
    "Unknown"
  ],
  "rules": [
    {
      "fix": "Inspect details.out_of_scope; nothing outside the plan may be written",
      "meaning": "Actual writes left the declared scope or a binding changed",
      "rule": "commit_verification",
      "where": "task commit, after real readback"
    },
    {
      "fix": "Put request_id on task_plan and authorization_id on task_execute",
      "meaning": "Step parameters carry operation arguments only",
      "rule": "operation_parameters_only",
      "where": "task_plan / task_dry_run step parameters"
    },
    {
      "fix": "Use an existing handle for the first step; never a planned new target name",
      "meaning": "$previous references the immediately preceding dataset output",
      "rule": "previous_dataset_output",
      "where": "task_plan / task_dry_run step references"
    },
    {
      "fix": "Use the canonical name or the exact published surface name",
      "meaning": "Only names published by the selected surface profile are accepted",
      "rule": "published_surface_names",
      "where": "MCP surface adapter"
    },
    {
      "fix": "Re-plan; recovery is only allowed from still-valid results",
      "meaning": "A committed step's dependency version is no longer valid",
      "rule": "resume_dependency_invalidated",
      "where": "task_execute resume gate"
    },
    {
      "fix": "Inspect task_get and evidence, then declare a new plan",
      "meaning": "Only FAILED plans resume; ISOLATED means unknown external state",
      "rule": "resume_state_not_recoverable",
      "where": "task_execute resume gate"
    },
    {
      "fix": "Read details.observation and details.details, correct the unit, object or version",
      "meaning": "A contract predicate refused the step; details.predicate names it",
      "rule": "verification_precheck",
      "where": "before any side effect, in both dry-run and execute"
    },
    {
      "fix": "Re-plan against the current versions; the old plan is refused",
      "meaning": "An input version or target state changed after planning",
      "rule": "version_binding_changed",
      "where": "task_execute commit gate"
    }
  ],
