    def test_join_rejects_a_swapped_right_record(rt):
        left = import_fc(rt, "left", [feature(box(0, 0, 10, 10), value=7)])
        right = import_fc(rt, "zones", [feature(box(5, 5, 15, 15), zone="A"),
                                        feature(box(6, 6, 16, 16), zone="B")])
